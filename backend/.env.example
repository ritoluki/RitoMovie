# Local development. In Render, enter these in Environment instead of uploading .env.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ritomovie
JWT_SECRET=replace-with-a-random-secret
JWT_EXPIRE=30d
FRONTEND_URL=http://localhost:5173
# Additional exact frontend origins, separated by commas. Do not use wildcards.
CORS_ORIGINS=
# Cloudflare Turnstile secret key. Keep this only in backend/Render environment.
TURNSTILE_SECRET_KEY=
PHIM_API_BASE_URL=https://phimapi.com
TMDB_API_KEY=
ENABLE_CACHE_WARMUP=false
# Production on Render Free: use resend and enter the three values below.
# Local SMTP settings remain configurable through Admin > Settings > Email.
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
EMAIL_FROM=noreply@ritomovie.live
EMAIL_FROM_NAME=RitoMovie
# Keep disk-based video uploads disabled on ephemeral hosting.
ENABLE_LOCAL_VIDEO_UPLOADS=false
