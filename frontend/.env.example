# Local: /api uses the Vite proxy. Cloudflare: https://YOUR-BACKEND.onrender.com/api
VITE_API_BASE_URL=/api
VITE_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
# Optional. Set in Cloudflare Pages and local frontend/.env to enable Google login.
# Authorized origins in Google Cloud: http://localhost:5173 and each live site origin.
VITE_GOOGLE_CLIENT_ID=
# Cloudflare Turnstile public site key for the login/register/password reset forms.
VITE_TURNSTILE_SITE_KEY=
